PORT=9247
APP_ENV=development
DEMO_MODE=false
MOCK_INTEGRATIONS=false
ALLOW_DEV_IDENTITY_HEADERS=false
ALLOW_DEV_MAGIC_LINKS=true

# Database
DATABASE_URL=postgresql+psycopg2://rights:rights@db:5432/rights_console
POSTGRES_DB=rights_console
POSTGRES_USER=rights
POSTGRES_PASSWORD=rights
POSTGRES_PORT=5446

# Console
CONSOLE_PORT=6482
CONSOLE_BASE_URL=http://localhost:6482
CORS_ALLOW_ORIGINS=http://localhost:6482,http://localhost:5174
RATE_LIMIT=100/minute
STRUCTURED_LOGGING=false
LOG_LEVEL=INFO

# Auth / sessions
RIGHTS_MAGIC_LINK_SECRET=
RIGHTS_MAGIC_LINK_EXP_MINUTES=30
RIGHTS_SESSION_TTL_MINUTES=30
NODE_OPERATOR_EMAILS=operator@example.com
# Use operator_only for private pilots; open allows any verified email to onboard.
AUTH_SIGNUP_MODE=open
# disabled, mailgun, or smtp. Adopter staging/production requires mailgun or smtp.
NOTIFICATION_PROVIDER=disabled
NOTIFICATION_FROM_EMAIL=Clef Rights <rights@example.com>
NOTIFICATION_CONNECT_TIMEOUT_SECONDS=5
NOTIFICATION_READ_TIMEOUT_SECONDS=15
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.clef.pro
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls, implicit, or none. Production SMTP requires authentication and encryption.
SMTP_SECURITY=starttls

# Node identity and signing. Generate a persistent Ed25519 key before staging/production.
NODE_ID=urn:clef:rights-node:example
# local_evaluation, public_sandbox, adopter_staging, or adopter_production.
NODE_DEPLOYMENT_MODE=local_evaluation
# Anonymous short-lived sessions are allowed only in public_sandbox mode.
SANDBOX_GUEST_ACCESS=false
NODE_SIGNING_PRIVATE_KEY_B64=

# Explicitly published catalog discovery across verified, configured peers.
# See docs/foundation/CATALOG_FEDERATION.md. Disabled until an operator configures it.
FEDERATION_ENABLED=false
FEDERATION_PUBLIC_ORIGIN=
FEDERATION_PEERS_JSON=[]
FEDERATION_ALLOW_LOOPBACK=false
# Optional: the public key of this node's next signing key, published so peers can pin it before a rotation.
NODE_NEXT_SIGNING_PUBLIC_KEY_B64=
# Optional: comma-separated public keys this node signed with before a rotation, so its older receipts keep verifying.
NODE_RETIRED_SIGNING_PUBLIC_KEYS_B64=
# Public corresponding source for the exact deployed build. Required in staging/production.
SOURCE_CODE_URL=
SOURCE_CODE_REVISION=

# Webhook secrets are encrypted with a separate 32-byte URL-safe base64 key.
# Development derives a local key when blank; staging/production require this value.
WEBHOOK_ENCRYPTION_KEY_B64=
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_DELIVERY_ENABLED=true
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_WORKER_INTERVAL_SECONDS=10

# Signed permission expiry. Run exactly one expiry worker per node deployment.
EXPIRY_WORKER_INTERVAL_SECONDS=86400

# Integrations (optional)
MLC_ENABLED=false
MLC_USERNAME=
MLC_PASSWORD=
MLC_BASE_URL=https://public-api.themlc.com
MLC_AUTHORIZED_CAPABILITIES=catalog_lookup,ownership_evidence_read
MLC_CONNECT_TIMEOUT_SECONDS=5
MLC_READ_TIMEOUT_SECONDS=20
MLC_MAX_RETRIES=3
MLC_MAX_RESPONSE_BYTES=5000000
DDEX_ENABLED=false
DDEX_IMPLEMENTATION_LICENSE_CONFIRMED=false
DDEX_DPID=
DDEX_PARTNER_DPID=
DDEX_SENDER_NAME=
DDEX_PARTNER_NAME=
DDEX_PROFILE=mwl-1.0.1
DDEX_SCHEMA_DIR=./var/ddex/mwl-1.0.1
DDEX_MWL_XSD_PATH=/run/secrets/ddex/us-works-licensing-choreography.xsd
DDEX_LIVE_MESSAGES=false
DDEX_AUTHORIZED_CAPABILITIES=
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_CLIENT_ID=
MUSICBRAINZ_CLIENT_SECRET=
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
OPENROUTER_API_KEY=
OPENROUTER_INTENT_MODEL=openai/gpt-4o-mini
SLACK_WEBHOOK_URL=

# Frontend build
VITE_API_BASE=/api
VITE_DEMO_MODE=false
# Runtime API origin used by the nginx reverse proxy. Railway should point this
# at the API service's private domain and port.
API_UPSTREAM=http://api:9247

# Header the hosting edge sets to the client address (X-Real-IP on Railway). Leave empty when clients reach the API directly.
CLIENT_IP_HEADER=
